$presetThemeId: f21551a1-7244-432f-ad88-220609e070d3;
$isModified: true;

$name: GREY;

// Brand & Palette
$color1: #61bcff;    // blue (for header background, info styles)
$color2: #a2e436;    // lime (primary accents, buttons)
$color3: #f8f9fa;    // light gray (backgrounds, card faces)
$color4: #212529;    // darkest gray (dark backgrounds, footer)
$color5: #fff;       // white
$color6: #68d391;    // green (success, highlights)
$color7: #000;       // black (main text, icons)
$color8: #22d2ed;    // cyan (info cards, icons)
$color9: #ffc700;    // yellow (warning)
$color10: #fa984a;   // orange
$color11: #be82fa;   // purple (optional accent)
$color12: #f56565;   // red (danger)

$primaryColor: $color2;
$headerColor: $color1;
$headerMenuTextColor: $color7;      // black
$headerMenuHoverColor: $color4;     // dark gray
$bodyBackground: $color5;           // white
$footerColor: $color4;
$footerTextColor: $color5;

// Typography
$footerTextFont: Arial;
$footerTextWeight: 400;
$footerTextSize: 16;

$headerMenuTextFont: Arial;
$headerMenuTextWeight: 500;          // medium (Bootswatch heading weight)
$headerMenuTextSize: 20;
$headerMenuHoverStyle: Underline;

$siteTitlecolor: $color7;            // black
$siteTitlefont: Arial;
$siteTitleweight: 500;
$siteTitlesize: 30;

$h1font: Arial;
$h1weight: 500;
$h1size: 40;
$h1color: $color7;

$h2font: Arial;
$h2weight: 500;
$h2size: 36;
$h2color: $color7;

$h3font: Arial;
$h3weight: 500;
$h3size: 24;
$h3color: $color7;

$h4font: Arial;
$h4weight: 700;                      // bold
$h4size: 24;
$h4color: $color7;

$h5font: Arial;
$h5weight: 700;
$h5size: 14;
$h5color: $color7;

$p1font: Arial;
$p1weight: 400;
$p1size: 20;
$p1color: $color7;

$p2font: Arial;
$p2weight: 400;
$p2size: 16;
$p2color: $color7;

// Links
$afont: Arial;
$aweight: 400;
$asize: 14;
$atextcolor: $color4;
$astyle: Plain text;
$aonhoverstyle: Underline;
$aonhovertextcolor: $color1;         // blue on hover

// Buttons
$button1style: Filled;
$button1radius: 6;                   // .375rem (default Brite Button)
$button1font: Arial;
$button1weight: 500;
$button1size: 14;
$button1fillcolor: $color2;          // lime
$button1textcolor: $color7;          // black
$button1onhoverstyle: Filled;
$button1onhoverfillcolor: $color1;   // blue on hover
$button1onhovertextcolor: $color5;   // white text on hover

$button2style: Outline;
$button2radius: 6;                   // match filled button radius
$button2font: Arial;
$button2weight: 500;
$button2size: 14;
$button2fillcolor: $color4;          // dark
$button2textcolor: $color4;          // dark text
$button2onhoverstyle: Filled;
$button2onhoverfillcolor: $color2;   // lime on hover
$button2onhovertextcolor: $color5;   // white text on hover

// Spacing & Layout
$sectioncolumnmargintopbottom: 60;
$sectioncolumnmarginunit: px;
$sectioncolumnpaddingunit: px;
$sectioncolumncontentpadding: 16;

// Component Radius (cards, input, nav, etc.)
$border-radius: 6;                    // .375rem
$border-radius-sm: 4;                 // .25rem
$border-radius-lg: 8;                 // .5rem

// Additional component colors for consistency
$successColor: $color6;
$infoColor: $color8;
$warningColor: $color9;
$dangerColor: $color12;
$lightColor: $color3;
$darkColor: $color4;

